{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*.ts", "plugins/**/*.ts", "examples/**/*.ts", "src/**/*.ts", "ts/**/*.ts", "testing/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  // tests/fixtures holds inputs the tests read or run as data, never import.
  "exclude": ["node_modules", "dist", ".claude", "tests/fixtures"]
}
