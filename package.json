{
  "name": "@sibylline-labs/eris",
  "version": "0.0.0",
  "description": "A plugin-composed command-line tool in TypeScript on Bun, shipping eris yak",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sibylline-labs/eris.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "eris": "bin/eris.ts"
  },
  "exports": {
    ".": "./src/main.ts",
    "./sdk": "./src/sdk.ts",
    "./sdk/testing": "./testing/index.ts",
    "./yak-contract": "./packages/yak-contract/src/index.ts",
    "./socrates-core": "./packages/socrates-core/src/index.ts",
    "./yak-redact": "./plugins/yak/yak-redact.ts"
  },
  "files": [
    "bin",
    "src",
    "plugins",
    "packages/yak-contract/src",
    "packages/yak-contract/schema",
    "packages/yak-contract/package.json",
    "packages/socrates-core/src",
    "packages/socrates-core/package.json",
    "testing",
    "ts",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "bun-types": "1.4.4",
    "typescript": "^6.0.3"
  }
}
