# The Homebrew formula for eris. The release workflow renders this template with
# scripts/render-formula.ts (the tag and each binary's sha256 from the release's
# SHA256SUMS) and commits the result to the tap as Formula/eris.rb. The
# upper-case words between at-signs are the only parts that change per release.
class Eris < Formula
  desc "Plugin-composed command-line tool: slugged failures, JSON output, Yaks"
  homepage "https://github.com/@REPO@"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    depends_on arch: :arm64

    on_arm do
      url "https://github.com/@REPO@/releases/download/@TAG@/eris-darwin-arm64"
      sha256 "@SHA256_DARWIN_ARM64@"
    end
  end

  on_linux do
    depends_on arch: :x86_64

    on_intel do
      url "https://github.com/@REPO@/releases/download/@TAG@/eris-linux-x64"
      sha256 "@SHA256_LINUX_X64@"
    end
  end

  def install
    asset = OS.mac? ? "eris-darwin-arm64" : "eris-linux-x64"
    bin.install asset => "eris"
  end

  test do
    assert_match "eris v#{version}", shell_output("#{bin}/eris --version")
  end
end
